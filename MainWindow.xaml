<Window x:Class="SpotifyIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotify Island"
        Width="480" Height="150"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Chrome-less round-ish icon button used for prev / play-pause / next -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- The notch: flush with the top of the screen, only the bottom corners are rounded.
             Its background is a radial gradient that gets tinted with the album art colour. -->
        <Border x:Name="Island"
                Width="168" Height="4" Opacity="0"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0" ClipToBounds="True"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave">
            <Border.Background>
                <RadialGradientBrush x:Name="GlowBrush" Center="0.153,0.5" GradientOrigin="0.153,0.5"
                                     RadiusX="0.31" RadiusY="0.9">
                    <GradientStop x:Name="Glow0" Color="#FF000000" Offset="0"/>
                    <GradientStop x:Name="Glow1" Color="#FF000000" Offset="0.55"/>
                    <GradientStop Color="#FF000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>

            <Grid>

                <!-- ============ COMPACT STATE ============ -->
                <Grid x:Name="CompactContent" Opacity="0" Width="220" Height="34"
                      HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Border Width="20" Height="20" CornerRadius="5"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,2">
                        <Border.Background>
                            <ImageBrush x:Name="CompactArtBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="CompactTitle" Foreground="White" FontSize="12"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="44,0,16,2"/>
                    <Border Height="2" VerticalAlignment="Bottom" Margin="22,0,22,4"
                            CornerRadius="1" Background="#33FFFFFF">
                        <Border x:Name="CompactFillBar" Background="White" CornerRadius="1"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CompactScale" ScaleX="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </Grid>

                <!-- ============ EXPANDED STATE ============ -->
                <Grid x:Name="ExpandedContent" Opacity="0" IsHitTestVisible="False"
                      Width="420" Height="136"
                      HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Margin="22,16,22,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="80" Height="80" CornerRadius="14"
                                VerticalAlignment="Center">
                            <Border.Background>
                                <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock x:Name="TitleText" Foreground="White" FontSize="16"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ArtistText" Foreground="#FFC4C4C4" FontSize="13"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       TextTrimming="CharacterEllipsis"/>

                            <Border Height="4" CornerRadius="2" Background="#33FFFFFF" Margin="0,8,0,0">
                                <Border x:Name="FillBar" Background="White" CornerRadius="2"
                                        RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="FillScale" ScaleX="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>

                            <Grid Margin="0,4,0,0">
                                <TextBlock x:Name="ElapsedText" Foreground="#B3FFFFFF" FontSize="11"
                                           HorizontalAlignment="Left" Text="0:00"/>
                                <TextBlock x:Name="TotalText" Foreground="#B3FFFFFF" FontSize="11"
                                           HorizontalAlignment="Right" Text="0:00"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Button x:Name="PrevButton" Style="{StaticResource IconButton}"
                                        Content="&#xE892;" Click="Prev_Click"/>
                                <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}"
                                        Content="&#xE769;" FontSize="20" Width="46" Margin="6,0"
                                        Click="PlayPause_Click"/>
                                <Button x:Name="NextButton" Style="{StaticResource IconButton}"
                                        Content="&#xE893;" Click="Next_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
