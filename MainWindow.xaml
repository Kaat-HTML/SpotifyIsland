<Window x:Class="SpotifyIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Spotify Island"
        Width="480" Height="164"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Chrome-less icon button used for prev / play-pause / next -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- The notch. Its shape is cut in code (curved ears + rounded bottom);
             the background is a radial gradient tinted by the album art / the weather. -->
        <Border x:Name="Island"
                Width="168" Height="4" Opacity="0"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0" ClipToBounds="True"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                MouseWheel="Island_MouseWheel">
            <Border.Background>
                <RadialGradientBrush x:Name="GlowBrush" Center="0.153,0.5" GradientOrigin="0.153,0.5"
                                     RadiusX="0.31" RadiusY="0.9">
                    <GradientStop x:Name="Glow0" Color="#FF000000" Offset="0"/>
                    <GradientStop x:Name="Glow1" Color="#FF000000" Offset="0.55"/>
                    <GradientStop Color="#FF000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>

            <Grid>

                <!-- ====================== COMPACT STATE ====================== -->
                <Grid x:Name="CompactContent" Opacity="0" Width="220" Height="38"
                      HorizontalAlignment="Center" VerticalAlignment="Top">

                    <!-- compact: music -->
                    <Grid x:Name="CompactMusic" Opacity="0">
                        <Border Width="20" Height="20" CornerRadius="5"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,2">
                            <Border.Background>
                                <ImageBrush x:Name="CompactArtBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <TextBlock x:Name="CompactTitle" Foreground="White" FontSize="12"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="44,0,16,2"/>
                        <StackPanel x:Name="CompactMiniWeather" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,14,2" Visibility="Collapsed">
                            <Image x:Name="MiniIcon" Width="17" Height="17"/>
                            <TextBlock x:Name="MiniTemp" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       Margin="3,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Height="2" VerticalAlignment="Bottom" Margin="22,0,22,4"
                                CornerRadius="1" Background="#33FFFFFF">
                            <Border x:Name="CompactFillBar" Background="White" CornerRadius="1"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="CompactScale" ScaleX="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Grid>

                    <!-- compact: weather (when no music is playing) -->
                    <Grid x:Name="CompactWeather" Opacity="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Margin="14,0,14,2">
                            <Image x:Name="CwIcon" Width="22" Height="22"/>
                            <TextBlock x:Name="CwTemp" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CwText" Foreground="#B3FFFFFF" FontSize="11.5"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       Margin="8,0,0,0" MaxWidth="118" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ====================== EXPANDED STATE ====================== -->
                <Grid x:Name="ExpandedContent" Opacity="0" IsHitTestVisible="False"
                      Width="420" Height="148"
                      HorizontalAlignment="Center" VerticalAlignment="Top">

                    <!-- page 1: music -->
                    <Grid x:Name="MusicPage">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="MusicShift" Y="0"/>
                        </Grid.RenderTransform>

                        <Grid Margin="22,16,22,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="80" Height="80" CornerRadius="14"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock x:Name="TitleText" Foreground="White" FontSize="16"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ArtistText" Foreground="#FFC4C4C4" FontSize="13"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           TextTrimming="CharacterEllipsis"/>

                                <Border Height="4" CornerRadius="2" Background="#33FFFFFF" Margin="0,8,0,0">
                                    <Border x:Name="FillBar" Background="White" CornerRadius="2"
                                            RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="FillScale" ScaleX="0"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>

                                <Grid Margin="0,4,0,0">
                                    <TextBlock x:Name="ElapsedText" Foreground="#B3FFFFFF" FontSize="11"
                                               HorizontalAlignment="Left" Text="0:00"/>
                                    <TextBlock x:Name="TotalText" Foreground="#B3FFFFFF" FontSize="11"
                                               HorizontalAlignment="Right" Text="0:00"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                    <Button x:Name="PrevButton" Style="{StaticResource IconButton}"
                                            Content="&#xE892;" Click="Prev_Click"/>
                                    <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}"
                                            Content="&#xE769;" FontSize="20" Width="46" Margin="6,0"
                                            Click="PlayPause_Click"/>
                                    <Button x:Name="NextButton" Style="{StaticResource IconButton}"
                                            Content="&#xE893;" Click="Next_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- page 2: weather -->
                    <Grid x:Name="WeatherPage" Opacity="0" IsHitTestVisible="False">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="WeatherShift" Y="148"/>
                        </Grid.RenderTransform>

                        <Grid Margin="22,14,22,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="138"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- now -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Image x:Name="WxIcon" Width="44" Height="44"/>
                                    <TextBlock x:Name="WxTemp" Foreground="White" FontSize="34" FontWeight="SemiBold"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="WxDesc" Foreground="White" FontSize="12"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           TextTrimming="CharacterEllipsis" Margin="2,2,0,0"/>
                                <TextBlock x:Name="WxFeel" Foreground="#B3FFFFFF" FontSize="11"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           TextTrimming="CharacterEllipsis" Margin="2,2,0,0"/>
                                <TextBlock x:Name="WxWind" Foreground="#B3FFFFFF" FontSize="11"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           TextTrimming="CharacterEllipsis" Margin="2,0,0,0"/>
                                <TextBlock x:Name="WxSource" Text="Bron: Buienradar.nl" Foreground="#80FFFFFF"
                                           FontSize="9" Margin="2,5,0,0" Cursor="Hand"
                                           ToolTip="https://www.buienradar.nl"
                                           MouseLeftButtonUp="Source_Click"/>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="#1FFFFFFF" Margin="10,6"/>

                            <!-- next days + rain -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0">
                                <prim:UniformGrid x:Name="DaysGrid" Rows="1" Columns="5"/>
                                <TextBlock x:Name="RainCaption" Foreground="#CCFFFFFF" FontSize="10.5"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           Margin="0,6,0,3"/>
                                <prim:UniformGrid x:Name="RainBars" Rows="1" Columns="24" Height="16"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- page dots (only when both music and weather are available) -->
                    <StackPanel x:Name="PagerDots" Orientation="Vertical"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,8,3,0" Visibility="Collapsed">
                        <Border Width="16" Height="16" Background="Transparent" Cursor="Hand"
                                MouseLeftButtonUp="DotMusic_Click">
                            <Ellipse x:Name="DotMusic" Width="6" Height="6" Fill="White"/>
                        </Border>
                        <Border Width="16" Height="16" Background="Transparent" Cursor="Hand"
                                MouseLeftButtonUp="DotWeather_Click">
                            <Ellipse x:Name="DotWeather" Width="6" Height="6" Fill="#55FFFFFF"/>
                        </Border>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
